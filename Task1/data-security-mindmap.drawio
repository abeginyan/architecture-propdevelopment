<mxfile host="app.diagrams.net" version="24.8.0"><diagram name="Безопасность данных" id="sec-data-mindmap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:20px'&gt;Безопасность данных&lt;/b&gt;&lt;br&gt;PropDevelopment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006eaf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="1015.0" width="260" height="120" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style='font-size:15px'&gt;Публичные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="200.0" width="250" height="100" as="geometry"/></mxCell><mxCell id="n4" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="&lt;i style='color:#555555'&gt;Открытая информация, раскрытие которой не вредит компании&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Каталог объектов недвижимости на витрине: описания, планировки, фото, цены&lt;br&gt;• Контент онлайн-тура: 3D-модели и панорамы объектов (client-tour-app)&lt;br&gt;• Общая информация о компании и жилых комплексах&lt;br&gt;• Общедоступные объявления для жильцов&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="10" width="430" height="480" as="geometry"/></mxCell><mxCell id="n6" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="20.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n8" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="Данные и так опубликованы на витрине. Раскрытие ещё не опубликованных объектов даёт конкурентам немного информации, ущерб невелик." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="8.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n10" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="120.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n12" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="n5" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="Каталог можно восстановить из client-mart-estate-db и резервных копий. Недоступность витрины временная и не ведёт к юридическим последствиям." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="108.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n14" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="220.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n16" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="Подмена цены, площади или планировки в каталоге вводит клиентов в заблуждение и ведёт к претензиям. Каталог идёт через Kafka и REST без контроля целостности." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="208.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n18" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="320.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n20" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n5" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="Устаревшие или дублирующиеся карточки объектов в витрине снижают доверие покупателей и портят воронку продаж." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="308.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n22" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="420.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n24" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="n5" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="Цены и наличие быстро устаревают, но это штатно обновляется при публикации каталога. Ценность публичной информации и так невысока." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="408.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n26" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b style='font-size:15px'&gt;Внутренние данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="750.0" width="250" height="100" as="geometry"/></mxCell><mxCell id="n28" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#9673a6;strokeWidth=3;" edge="1" parent="1" source="n2" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;i style='color:#555555'&gt;Информация для сотрудников и партнёров, не предназначенная для публикации&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Данные об объектах в client-mart-estate-db: статусы, остатки фонда, внутренние цены до публикации&lt;br&gt;• Графики и история текущего и капитального ремонта (tenant-core-app)&lt;br&gt;• Результаты осмотров и онлайн-туров без привязки к клиенту&lt;br&gt;• Агрегированная BI-отчётность и справочники в хранилище&lt;br&gt;• Тарифы и сведения от управляющих компаний и поставщиков ресурсов ЖКХ&lt;br&gt;• Описания API-контрактов, схемы интеграций, технические логи сервисов&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="430" height="480" as="geometry"/></mxCell><mxCell id="n30" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="570.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n32" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="Раскрываются внутренние цены, бизнес-процессы и устройство интеграций, это облегчает атаки и даёт преимущество конкурентам. Системы обработки данных не ограничивают доступ, ограничения есть только в бизнес-процессах." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="558.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n34" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="670.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n36" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n29" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="Резервное копирование есть, но потеря истории ремонтов и отчётности нарушает работу управляющих компаний и операционных команд." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="658.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n38" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="770.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n40" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n29" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="Неверные статусы и остатки фонда приводят к двойному бронированию, а искажённая история ремонтов к ошибкам в планировании работ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="758.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n42" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n39" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="870.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n44" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n29" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n45" value="Данные из разных систем не согласованы, потоки не контролируются системно. Это прямо блокирует запуск BI-, ML- и AI-сервисов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="858.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n46" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n43" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;НЕЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="970.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n48" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="n29" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="Устаревшие отчёты и справочники обновляются в штатном режиме. Прямого финансового ущерба нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="958.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n50" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=1;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b style='font-size:15px'&gt;Конфиденциальные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="1300.0" width="250" height="100" as="geometry"/></mxCell><mxCell id="n52" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1" source="n2" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="&lt;i style='color:#555555'&gt;Информация, раскрытие которой нанесёт ущерб людям и компании, включая персональные данные&lt;/i&gt;&lt;br&gt;&lt;br&gt;• ПДн клиентов: ФИО, телефон, e-mail, расширенная форма (client-crm-db, client-mart-db)&lt;br&gt;• ПДн собственников (crm-tenant-db)&lt;br&gt;• Бронирования и онлайн-сделки по недвижимости (client-mart-db)&lt;br&gt;• Платёжные операции и начисления за ЖКУ (tenant-core-db, платёжная система)&lt;br&gt;• Бухгалтерские данные (accountant-service-1)&lt;br&gt;• Сырые копии всех баз в хранилище Greenplum и DWH на S3&lt;br&gt;• Данные «Умного дома»: события и режим использования квартиры&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="1110" width="430" height="480" as="geometry"/></mxCell><mxCell id="n54" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="n51" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1120.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n56" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n53" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n57" value="Утекают персональные данные: это штрафы по 152-ФЗ и репутационный ущерб, как у конкурента в СМИ. Контракты API уже содержат ПДн, а партнёр одной УК видит данные другой." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1108.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n58" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="n55" target="n57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n59" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1220.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n60" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n53" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n61" value="Бэкапы есть, но потеря сделок, платежей и бухгалтерии ведёт к финансовым спорам и нарушению отчётности. Восстановление возможно, поэтому риск ниже критического." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1208.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n62" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n59" target="n61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1320.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n64" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n53" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n65" value="Клиенты уже видят в кабинете чужое ФИО: данные разных людей смешиваются. Искажение платежей и условий сделок ведёт к прямым финансовым и юридическим потерям." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1308.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n66" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="n63" target="n65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n67" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1420.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n68" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n53" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n69" value="Клиента регистрируют в нескольких местах без координации, возникают дубли и расхождения. Это снижает удовлетворённость клиентов и портит данные для ML." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1408.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n70" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n67" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n71" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1520.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n72" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n53" target="n71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n73" value="Контакты и профили устаревают, а хранение ПДн дольше необходимого нарушает закон. Устаревшие данные бесполезны для новых сервисов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1508.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n74" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n71" target="n73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n75" value="&lt;b style='font-size:15px'&gt;Секретные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="1850.0" width="250" height="100" as="geometry"/></mxCell><mxCell id="n76" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1" source="n2" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n77" value="&lt;i style='color:#555555'&gt;Информация, раскрытие которой даёт полный доступ к системам и данным&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Пароли, хэши и токены сессий (auth-db-1, Keycloak)&lt;br&gt;• Учётные записи и права в двух каталогах Active Directory&lt;br&gt;• Ключи и сертификаты электронной подписи для СМЭВ и госорганов&lt;br&gt;• API-ключи и секреты интеграций с УК и платёжной системой&lt;br&gt;• Ключи шифрования баз данных и резервных копий&lt;br&gt;• Ключи управления замком и автоматикой в «Умном доме»&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="1660" width="430" height="480" as="geometry"/></mxCell><mxCell id="n78" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n75" target="n77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n79" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1670.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n80" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n77" target="n79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n81" value="Компрометация секретов даёт полный доступ к системам, ПДн и платежам, а в «Умном доме» к замкам квартир. Единых политик безопасности для API партнёров нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1658.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n82" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="n79" target="n81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n83" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1770.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n84" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n77" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n85" value="Потеря ключей шифрования или сертификатов СМЭВ останавливает онлайн-сделки и делает резервные копии нечитаемыми. Восстановить такие секреты нельзя." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1758.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n86" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="n83" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n87" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;КРИТИЧЕСКИЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1870.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n88" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n77" target="n87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n89" value="Подмена прав в Active Directory или сертификата даёт злоумышленнику легитимный доступ. Специалист по ИБ один, и ему передают не все изменения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1858.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n90" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="n87" target="n89"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n91" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="1970.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n92" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n77" target="n91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n93" value="Дубли и «мёртвые» учётные записи, лишние права и общий Keycloak для разных групп пользователей расширяют поверхность атаки." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="1958.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n94" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n91" target="n93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n95" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;ЗНАЧИТЕЛЬНЫЙ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1320" y="2070.0" width="250" height="60" as="geometry"/></mxCell><mxCell id="n96" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="n77" target="n95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n97" value="Секреты, которые не ротируются, и просроченные сертификаты перестают быть безопасными или ломают интеграции. Единой политики ротации нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1700" y="2058.0" width="640" height="84" as="geometry"/></mxCell><mxCell id="n98" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#d6b656;strokeWidth=1;" edge="1" parent="1" source="n95" target="n97"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n99" value="Тема" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="260" height="40" as="geometry"/></mxCell><mxCell id="n100" value="Категория данных" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="-70" width="250" height="40" as="geometry"/></mxCell><mxCell id="n101" value="Какие данные относятся к категории" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="-70" width="430" height="40" as="geometry"/></mxCell><mxCell id="n102" value="Риск и его оценка" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="-70" width="250" height="40" as="geometry"/></mxCell><mxCell id="n103" value="Почему оценка именно такая" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1700" y="-70" width="640" height="40" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;Незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="2190" width="250" height="40" as="geometry"/></mxCell><mxCell id="n105" value="&lt;b&gt;Значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="2190" width="250" height="40" as="geometry"/></mxCell><mxCell id="n106" value="&lt;b&gt;Критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="2190" width="250" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>